**2. JavaScript — Backend and Database Connection**  
I’m using Express to create the API and mysql2 to communicate with the MySQL database.  
The backend includes the following endpoints:  
**Method**  
**Endpoint**  
**Description**  
GET  
/admin  
Retrieve all customers  
GET  
/clientes/:id  
Retrieve a customer by ID  
POST  
/clientes  
Register a new customer  
PUT  
/clientes/:id  
Update customer information  
DELETE  
/clientes/:id  
Delete a customer  
**Complete Express API**  
const express = require('express');  
const cors = require('cors');  
const mysql = require('mysql2/promise');


const app = express();
const port = 3000;

const db = mysql.createPool({
host: '127.0.0.1',
user: 'root',
password: '',
database: 'assistencia',
port: 3306
});

app.use(cors());
app.use(express.json());

// GET — Retrieve all customers
app.get('/admin', async (req, res) => {
try {
const [dados] = await db.query(
'SELECT * FROM cliente'
);

res.json(dados);

} catch (erro) {
console.error(erro);
res.status(500).json({
mensagem: 'Error retrieving customers'
});
}
});

// GET — Retrieve a customer by ID
app.get('/clientes/:id', async (req, res) => {
try {
const { id } = req.params;

const [dados] = await db.query(
'SELECT * FROM cliente WHERE id_cliente = ?',
[id]
);

if (dados.length === 0) {
return res.status(404).json({
mensagem: 'Customer not found'
});
}

res.json(dados[0]);

} catch (erro) {
console.error(erro);
res.status(500).json({
mensagem: 'Error retrieving customer'
});
}
});

// POST — Register a new customer
app.post('/clientes', async (req, res) => {
try {
const {
nome_completo,
cpf,
telefone,
email
} = req.body;

if (!nome_completo || !cpf || !telefone || !email) {
return res.status(400).json({
mensagem: 'Please fill in all fields'
});
}

const [resultado] = await db.query(
`INSERT INTO cliente
(nome_completo, cpf, telefone, email)
VALUES (?, ?, ?, ?)`,
[nome_completo, cpf, telefone, email]
);

res.status(201).json({
mensagem: 'Customer registered successfully',
id: resultado.insertId
});

} catch (erro) {
console.error(erro);
res.status(500).json({
mensagem: 'Error registering customer'
});
}
});

// PUT — Update customer information
app.put('/clientes/:id', async (req, res) => {
try {
const { id } = req.params;

const {
nome_completo,
cpf,
telefone,
email
} = req.body;

if (!nome_completo || !cpf || !telefone || !email) {
return res.status(400).json({
mensagem: 'Please fill in all fields'
});
}

const [resultado] = await db.query(
`UPDATE cliente
SET nome_completo = ?,
cpf = ?,
telefone = ?,
email = ?
WHERE id_cliente = ?`,
[nome_completo, cpf, telefone, email, id]
);

if (resultado.affectedRows === 0) {
return res.status(404).json({
mensagem: 'Customer not found'
});
}

res.json({
mensagem: 'Customer updated successfully'
});

} catch (erro) {
console.error(erro);
res.status(500).json({
mensagem: 'Error updating customer'
});
}
});

// DELETE — Delete a customer
app.delete('/clientes/:id', async (req, res) => {
try {
const { id } = req.params;

const [resultado] = await db.query(
'DELETE FROM cliente WHERE id_cliente = ?',
[id]
);

if (resultado.affectedRows === 0) {
return res.status(404).json({
mensagem: 'Customer not found'
});
}

res.json({
mensagem: 'Customer deleted successfully'
});

} catch (erro) {
console.error(erro);
res.status(500).json({
mensagem: 'Error deleting customer'
});
}
});

// START SERVER
app.listen(port, () => {
console.log(`Server running on port ${port}`);
});
3. How the Features Work
Customer Listing
The carregarClientes() function sends a GET request to /admin, retrieves customer records from the database, and displays them in the HTML table.
Customer Editing
The editarCliente(id) function retrieves a customer’s information through /clientes/:id and fills in the editing form.
When the form is submitted, a PUT request sends the updated information to the backend. After a successful update, the customer list is refreshed.
Customer Deletion
The excluirCliente(id) function asks the user to confirm the deletion.
If confirmed, it sends a DELETE request to /clientes/:id. After the backend deletes the record, the customer list is refreshed.
