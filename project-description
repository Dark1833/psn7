<script>

const API = 'http://localhost:3000';

// LOAD CUSTOMERS  
async function carregarClientes() {  
try {  
const resposta = await fetch(\`${API}/admin\`);

if (!resposta.ok) {  
throw new Error('Error loading customers');  
}

const dados = await resposta.json();

const tabela = document.querySelector('#clientes');  
tabela.innerHTML = '';

dados.forEach(c => {  
const linha = document.createElement('tr');

linha.className =  
'border-b border-\[#F0EFF7\] hover:bg-\[#FBFAFF\]';

linha.innerHTML = \`  
<td class="px-5 py-4">${c.nome\_completo ?? ''}</td>  
<td class="px-5 py-4">${c.email ?? ''}</td>  
<td class="px-5 py-4">${c.cpf ?? ''}</td>  
<td class="px-5 py-4">${c.telefone ?? ''}</td>  
<td class="px-5 py-4">${c.data\_cadastro ?? ''}</td>  
<td class="px-5 py-4">  
<button  
onclick="editarCliente(${Number(c.id\_cliente)})"  
class="bg-blue-600 text-white px-3 py-2 rounded">  
Edit  
</button>

<button  
onclick="excluirCliente(${Number(c.id\_cliente)})"  
class="bg-red-600 text-white px-3 py-2 rounded">  
Delete  
</button>  
</td>  
\`;

tabela.appendChild(linha);  
});

} catch (erro) {  
console.error(erro);  
alert('Could not load customers.');  
}  
}

// EDIT CUSTOMER  
async function editarCliente(id) {  
try {  
const resposta = await fetch(\`${API}/clientes/${id}\`);

if (!resposta.ok) {  
throw new Error('Customer not found');  
}

const cliente = await resposta.json();

document.querySelector('#id\_cliente').value =  
cliente.id\_cliente;

document.querySelector('#nome\_completo').value =  
cliente.nome\_completo;

document.querySelector('#email').value =  
cliente.email;

document.querySelector('#cpf').value =  
cliente.cpf;

document.querySelector('#telefone').value =  
cliente.telefone;

document.querySelector('#formularioEdicao')  
.classList.remove('hidden');

document.querySelector('#formularioEdicao')  
.scrollIntoView({ behavior: 'smooth' });

} catch (erro) {  
console.error(erro);  
alert('Error loading customer information.');  
}  
}

// SAVE CUSTOMER CHANGES  
document.querySelector('#formEditarCliente')  
.addEventListener('submit', async (e) => {

e.preventDefault();

const id = document.querySelector('#id\_cliente').value;

const cliente = {  
nome\_completo:  
document.querySelector('#nome\_completo').value,

email:  
document.querySelector('#email').value,

cpf:  
document.querySelector('#cpf').value,

telefone:  
document.querySelector('#telefone').value  
};

try {  
const resposta = await fetch(\`${API}/clientes/${id}\`, {  
method: 'PUT',  
headers: {  
'Content-Type': 'application/json'  
},  
body: JSON.stringify(cliente)  
});

const resultado = await resposta.json();

if (!resposta.ok) {  
throw new Error(  
resultado.mensagem || 'Update failed'  
);  
}

alert('Customer updated successfully!');

cancelarEdicao();  
carregarClientes();

} catch (erro) {  
console.error(erro);  
alert(erro.message);  
}  
});

// CANCEL EDITING  
function cancelarEdicao() {  
document.querySelector('#formularioEdicao')  
.classList.add('hidden');

document.querySelector('#formEditarCliente').reset();  
}

// DELETE CUSTOMER  
async function excluirCliente(id) {  
const confirmar = confirm(  
'Are you sure you want to delete this customer?'  
);

if (!confirmar) {  
return;  
}

try {  
const resposta = await fetch(\`${API}/clientes/${id}\`, {  
method: 'DELETE'  
});

const resultado = await resposta.json();

if (!resposta.ok) {  
throw new Error(  
resultado.mensagem || 'Deletion failed'  
);  
}

alert('Customer deleted successfully!');

carregarClientes();

} catch (erro) {  
console.error(erro);  
alert(erro.message);  
}  
}

// INITIALIZE PAGE  
carregarClientes();

</script>


